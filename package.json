{
  "name": "trading-assistant-mvp",
  "version": "1.0.0",
  "description": "Real-time trading discipline enforcement tool for MatchTrader",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron . --inspect",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac --universal",
    "pack": "electron-builder --dir",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "test": "echo \"Tests not implemented yet\" && exit 0",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rm -rf dist/ node_modules/.cache"
  },
  "build": {
    "appId": "com.tradingassistant.mvp",
    "productName": "Trading Assistant",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.finance",
      "entitlements": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.2.0",
    "jimp": "^0.22.0",
    "sharp": "^0.32.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  },
  "keywords": [
    "trading",
    "discipline",
    "automation",
    "finance",
    "electron",
    "macos"
  ],
  "author": "nottimlim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nottimlim/trading-assistant-mvp.git"
  }
}
